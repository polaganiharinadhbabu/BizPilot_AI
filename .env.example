DB_HOST=localhost
DB_PORT=5432
DB_NAME=bizpilot_db
DB_USER=postgres
DB_PASSWORD=CHANGE_THIS_TO_YOUR_POSTGRES_PASSWORD

# Generate a long random secret before running outside local development.
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
JWT_EXPIRE_MINUTES=480

# Create OAuth Client ID in Google Cloud Console and add your frontend origin.
GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID
FRONTEND_ORIGIN=http://localhost:5500
